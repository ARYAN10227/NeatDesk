{
  "name": "neatdesk-server",
  "version": "1.0.0",
  "description": "NeatDesk REST API: Express, Prisma (Neon PostgreSQL), Clerk auth and Inngest background jobs",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "dev": "nodemon server.js",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "check": "node --check server.js && for f in configs/*.js controllers/*.js routes/*.js middlewares/*.js inngest/*.js; do node --check $f || exit 1; done"
  },
  "keywords": [],
  "author": "Aryan Raj",
  "license": "MIT",
  "dependencies": {
    "@clerk/express": "^2.1.69",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "inngest": "^4.21.0",
    "nodemailer": "^10.0.10",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
