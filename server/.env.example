# Copy to .env and fill in. Never commit .env.
PORT=5000

# Neon PostgreSQL connection string (Neon dashboard -> Connection details)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Clerk (dashboard -> API keys)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Inngest (dashboard -> Manage -> Event keys / Signing key)
INNGEST_EVENT_KEY=xxx
INNGEST_SIGNING_KEY=signkey-prod-xxx

# Brevo SMTP for task emails
SMTP_USER=xxx@smtp-brevo.com
SMTP_PASS=xxx
SENDER_EMAIL=you@example.com
